# Signal Engine — local environment template.
#
# Copy to `.env` (which is git-ignored) and adjust as needed. Every value here is
# a NON-SECRET local-development default (docs/03-technical-spec.md Section 15).
# Secrets (e.g. future cloud LLM provider keys) are added to `.env` only, never
# committed and never given a real value here.

# --- Backend (Java / Spring Boot) ---
# Host binding: 127.0.0.1 for bare-metal local dev; docker-compose sets 0.0.0.0
# inside the container and only publishes the port to 127.0.0.1 on the host.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Cross-origin browser access to /api/v1 (docs/03-technical-spec.md Section 15.2: "CORS for
# local dev"). Must list every origin the browser actually loads the frontend from; defaults
# to the frontend dev server's own default origins (localhost and 127.0.0.1 on port 5173).
API_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database connection for the backend. When running the backend on the host,
# point at the published PostgreSQL port below. docker-compose overrides the URL
# to reach the `db` service on the Compose network. DATABASE_PASSWORD is a secret
# in the security sense (docs/03-technical-spec.md Section 15.2, 15.3) and only
# ever carries this local-only development value.
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/signal_engine
DATABASE_USERNAME=signal_engine
DATABASE_PASSWORD=signal_engine

# --- Agents (Python / FastAPI) ---
AGENTS_HOST=127.0.0.1
AGENTS_PORT=8100
LOG_LEVEL=info

# --- AI capability foundation (docs/adr/0006-ai-java-python-foundation.md) ---
# Backend -> Python AI service. docker-compose overrides this with the service name.
AGENTS_BASE_URL=http://127.0.0.1:8100
# Kept longer than AGENTS_LLM_REQUEST_TIMEOUT_SECONDS below, on purpose (Section 8.5).
AI_REQUEST_TIMEOUT=280s
# Python -> generative LLM provider. Final decision: "nvidia" (NVIDIA Build,
# OpenAI-compatible) for the generative LLM — near-duplicate, relevance, importance,
# summarization, and grounded Q&A all use this. "ollama" remains a selectable
# fallback (its adapter is unchanged) but is no longer the default and its model is
# no longer pulled automatically. "fake" runs without any model (then set
# AGENTS_FAKE_LLM_RESPONSES to a JSON array of strings).
AGENTS_LLM_PROVIDER=nvidia
# NVIDIA Build. NVIDIA_API_KEY is a SECRET — set it in .env only, never here; the
# adapter fails clearly at startup if AGENTS_LLM_PROVIDER=nvidia and it is unset.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_API_KEY=
# Only relevant if AGENTS_LLM_PROVIDER is switched back to "ollama" — not fetched
# or required by default (see OLLAMA_EMBEDDING_MODEL below for what Ollama is
# actually used for now).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:20b
# Published host port for the docker-compose `ollama` container (docs/03-technical-
# spec.md Section 17.2). Change this if a host machine already runs its own Ollama
# on the default 11434.
OLLAMA_PORT=11434
AGENTS_LLM_REQUEST_TIMEOUT_SECONDS=240
# Embedding model (docs/07-rag.md Section 22; docs/adr/0011) — Ollama's remaining
# job. "embeddinggemma" is the Task 8.3A benchmark recommendation (768-dim); T3
# stays open. docker-compose's ollama-pull service pulls it automatically.
AGENTS_EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=embeddinggemma
EMBEDDING_REQUEST_TIMEOUT_SECONDS=30

# --- Frontend (build-time) ---
VITE_API_BASE_URL=http://127.0.0.1:8080

# --- PostgreSQL (provisioned by docker-compose) ---
POSTGRES_DB=signal_engine
POSTGRES_USER=signal_engine
# Local-only development password. Not a secret in the security sense, but still
# lives in `.env`, never in source.
POSTGRES_PASSWORD=signal_engine
POSTGRES_PORT=5432
